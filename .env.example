# Required
ANTHROPIC_API_KEY=sk-ant-...
# MODEL=claude-haiku-5-5         # default; claude-opus-5-5 for ~40x the cost and somewhat better date/room extraction

# Where the app reads mail (any IMAP mailbox that your MIT Outlook forwards to)
IMAP_HOST=imap.gmail.com
IMAP_USER=you@gmail.com
IMAP_PASS=xxxx xxxx xxxx xxxx     # Gmail "app password", not your real password
# IMAP_MAILBOX=INBOX
# POLL_MINUTES=5

# Alternative/extra inbound path: POST raw .eml to /ingest with "Authorization: Bearer $INGEST_TOKEN"
INGEST_TOKEN=change-me
# ANALYZE_ALL=1                    # also read mail that is not dormspam / free-foods list. Leave unset if the whole mailbox is forwarded.
# INGEST_FROM_DOMAINS=mit.edu       # envelope-sender domains accepted from the Cloudflare worker (empty = accept all)
# MAX_INGEST_PER_SENDER_HOUR=30     # abuse caps; over the limit /ingest answers 429 and the worker bounces the mail
# MAX_INGEST_PER_DAY=1500
# INGEST_CORS_ORIGIN=https://outlook.office.com  # lets a script inside Outlook on the web POST to /ingest (browser backfill)

# Optional: require "Sign in with MIT" (Touchstone via https://petrock.mit.edu). Leave unset for a public site.
# OIDC_CLIENT_ID=...
# OIDC_CLIENT_SECRET=...
# OIDC_ISSUER=https://petrock.mit.edu
# ALLOWED_EMAIL_DOMAIN=mit.edu
# SESSION_SECRET=long-random-string
# ICS_TOKEN=random-string          # lets calendar apps fetch /calendar.ics?token=... when login is on

# Set automatically on Railway; override locally if needed
# PUBLIC_URL=http://localhost:3000
# DB_PATH=./freefood.db            # defaults to $RAILWAY_VOLUME_MOUNT_PATH/freefood.db on Railway
